# ----------------------------------------------------------------------------
# NoteSaaS environment configuration
# Copy this file to `.env` for local development:  cp .env.example .env
# In production (ECS) these values are injected via the task definition /
# AWS Secrets Manager by the deployment scripts — you do NOT edit them by hand.
# ----------------------------------------------------------------------------

# PostgreSQL connection string.
# Local dev (docker/local postgres):
#   postgres://postgres:postgres@localhost:5432/notesaas
# Production: provided automatically from the RDS endpoint by the deploy script.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/notesaas

# Whether to use TLS for the DB connection.
#   "false" for local Postgres (no TLS).
#   unset / anything else => TLS enabled (required for RDS).
DATABASE_SSL=false

# Secret used to sign session JWTs. MUST be at least 16 characters and kept
# secret. Generate with:  openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string-min-16-chars

# AWS region where the S3 bucket lives.
AWS_REGION=eu-central-1

# Name of the S3 bucket used to store note attachments.
# Created by the deploy script; for local dev point it at any bucket you can
# access with your local AWS credentials (or leave blank to disable uploads).
S3_BUCKET=

# Node environment. Leave as "development" locally; deploy sets "production".
NODE_ENV=development

# Mark the session cookie as `Secure` (HTTPS-only). Keep "false" while the app
# is served over plain HTTP (the default load-balanced endpoint). Set to "true"
# after putting the ALB behind an HTTPS listener (ACM certificate).
COOKIE_SECURE=false

# ----------------------------------------------------------------------------
# Local-only AWS credentials (NOT needed in ECS — the task role provides them).
# Only required locally if you want to exercise S3 uploads against a real bucket.
# ----------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
