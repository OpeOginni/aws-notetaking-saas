# PostgreSQL connection string. Local example uses the docker-compose database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/notes_saas

# Set false for local docker-compose PostgreSQL. Leave true/omit in AWS RDS where SSL is required.
DB_SSL=false

# AWS region used by S3 and deployment scripts.
AWS_REGION=eu-central-1

# S3 bucket for note attachments. Deployment scripts write the real bucket name to deployment-outputs.env.
S3_BUCKET_NAME=replace-with-your-bucket

# Set true only when serving the app over HTTPS. The provided ALB script uses HTTP, so it leaves this false.
COOKIE_SECURE=false

# Public origin used for absolute redirects from route handlers.
APP_URL=http://localhost:3000
